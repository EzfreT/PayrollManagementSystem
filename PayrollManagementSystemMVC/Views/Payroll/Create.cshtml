@{
    ViewData["Title"] = "Run Payroll";
}

<h2>Run Payroll</h2>

@if (ViewBag.Error != null)
{
    <div class="error-banner">@ViewBag.Error</div>
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="employeeId">Employee</label>
        <select name="employeeId" id="employeeId">
            <option value="">-- Select Employee --</option>
            @foreach (var emp in (List<Employee>)ViewBag.Employees)
            {
                <option value="@emp.EmployeeId">@emp.FirstName @emp.LastName (@emp.EmployeeNumber)</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="payPeriodStart">Pay Period Start</label>
        <input type="date" name="payPeriodStart" id="payPeriodStart" />
    </div>
    <div class="form-group">
        <label for="payPeriodEnd">Pay Period End</label>
        <input type="date" name="payPeriodEnd" id="payPeriodEnd" />
    </div>

    <button type="submit">Process Payroll</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>