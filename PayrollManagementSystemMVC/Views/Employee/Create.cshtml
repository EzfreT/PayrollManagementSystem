@model Employee
@{
    ViewData["Title"] = "Add Employee";
}

<h2>Add Employee</h2>

@if (ViewBag.Error != null)
{
    <div class="error-banner">@ViewBag.Error</div>
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="EmployeeNumber"></label>
        <input asp-for="EmployeeNumber" readonly />
    </div>
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" />
    </div>
    <div class="form-group">
        <label asp-for="MiddleName"></label>
        <input asp-for="MiddleName" />
    </div>
    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" />
    </div>
    <div class="form-group">
        <label asp-for="Gender"></label>
        <select asp-for="Gender">
            <option value="">-- Select --</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="BirthDate"></label>
        <input asp-for="BirthDate" type="date" />
    </div>
    <div class="form-group">
        <label asp-for="Position"></label>
        <input asp-for="Position" />
    </div>
    <div class="form-group">
        <label asp-for="Department"></label>
        <input asp-for="Department" />
    </div>
    <div class="form-group">
        <label asp-for="DateHired"></label>
        <input asp-for="DateHired" type="date" />
    </div>
    <div class="form-group">
        <label asp-for="ContactNumber"></label>
        <input asp-for="ContactNumber" />
    </div>
    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" />
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
    </div>
    <div class="form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
    </div>

    <button type="submit">Save Employee</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
